
<Window x:Class="FokusApp.Views.AlarmNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengingat Salat"
        Height="360"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF0F5"
        Topmost="True">

    <Border CornerRadius="20"
            Margin="15"
            Padding="25"
            Background="#EEF0F5">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="🔔"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Waktunya Salat"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#30364A"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,8"/>

            <TextBlock x:Name="PrayerNameText"
                       Text="Subuh"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#2A5CFF"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Sudah memasuki waktu salat."
                       FontSize="14"
                       Foreground="#656B7A"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,22"/>

            <Button Content="Tutup"
                    Width="130"
                    Height="40"
                    Background="#2A5CFF"
                    Foreground="White"
                    BorderThickness="0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</Window>
