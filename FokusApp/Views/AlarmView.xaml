<UserControl x:Class="FokusApp.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kartu Jadwal Salat -->
        <ContentControl Style="{StaticResource NeuCard}">
            <StackPanel>
                <TextBlock Text="Jadwal Salat"
                           Style="{StaticResource Heading}"/>

                <TextBlock Text="Pilih lokasi kamu"
                           Margin="0,12,0,5"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Provinsi"
                           Margin="0,8,0,4"
                           Foreground="{StaticResource TextBrush}"/>
                <ComboBox x:Name="ProvinceComboBox"
                          Height="36"
                          Padding="6"
                          IsEditable="False"
                          ToolTip="Pilih provinsi"/>

                <TextBlock Text="Kabupaten / Kota"
                           Margin="0,10,0,4"
                           Foreground="{StaticResource TextBrush}"/>
                <ComboBox x:Name="RegencyComboBox"
                          Height="36"
                          Padding="6"
                          IsEnabled="False"
                          ToolTip="Pilih kabupaten atau kota"/>

                <TextBlock Text="Kecamatan"
                           Margin="0,10,0,4"
                           Foreground="{StaticResource TextBrush}"/>
                <ComboBox x:Name="DistrictComboBox"
                          Height="36"
                          Padding="6"
                          IsEnabled="False"
                          ToolTip="Pilih kecamatan"/>

                <Button x:Name="LoadPrayerTimesButton"
                        Content="Tampilkan Jadwal"
                        Width="170"
                        Height="40"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource NeuButtonAccent}"
                        IsEnabled="False"/>

                <TextBlock Text="Waktu Salat"
                           Style="{StaticResource Heading}"
                           Margin="0,22,0,5"/>

                <TextBlock x:Name="SelectedLocationText"
                           Text="Belum ada lokasi dipilih"
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Subuh"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="FajrText"
                               Grid.Row="0" Grid.Column="1"
                               Text="--:--"
                               FontSize="17"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Grid.Row="1" Text="Dzuhur"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="DhuhrText"
                               Grid.Row="1" Grid.Column="1"
                               Text="--:--"
                               FontSize="17"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Grid.Row="2" Text="Ashar"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="AsrText"
                               Grid.Row="2" Grid.Column="1"
                               Text="--:--"
                               FontSize="17"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Grid.Row="3" Text="Maghrib"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="MaghribText"
                               Grid.Row="3" Grid.Column="1"
                               Text="--:--"
                               FontSize="17"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Grid.Row="4" Text="Isya"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="IshaText"
                               Grid.Row="4" Grid.Column="1"
                               Text="--:--"
                               FontSize="17"
                               Foreground="{StaticResource TextBrush}"/>
                </Grid>
            </StackPanel>
        </ContentControl>

        <!-- Kolom Kanan: Alarm Salat + Alarm Kustom -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Kartu Pengaturan Alarm Salat -->
            <ContentControl Grid.Row="0"
                            Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Pengaturan Alarm Salat"
                               Style="{StaticResource Heading}"/>

                    <TextBlock Text="Pilih waktu salat yang ingin diingatkan."
                               FontSize="13"
                               Margin="0,8,0,10"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"/>

                    <UniformGrid Columns="2">
                        <CheckBox x:Name="FajrAlarmCheckBox" Content="Subuh" FontSize="15" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                        <CheckBox x:Name="DhuhrAlarmCheckBox" Content="Dzuhur" FontSize="15" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                        <CheckBox x:Name="AsrAlarmCheckBox" Content="Ashar" FontSize="15" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                        <CheckBox x:Name="MaghribAlarmCheckBox" Content="Maghrib" FontSize="15" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                        <CheckBox x:Name="IshaAlarmCheckBox" Content="Isya" FontSize="15" Margin="0,4" Foreground="{StaticResource TextBrush}"/>
                    </UniformGrid>

                    <Button x:Name="SaveAlarmSettingsButton"
                            Content="Simpan Alarm Salat"
                            Width="190"
                            Height="40"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource NeuButtonAccent}"/>
                </StackPanel>
            </ContentControl>

            <!-- Kartu Alarm Kustom -->
            <ContentControl Grid.Row="1"
                            Style="{StaticResource NeuCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Alarm Kustom"
                               Style="{StaticResource Heading}"/>

                    <!-- Form Tambah Alarm -->
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CustomTimeInput"
                                 Grid.Column="0"
                                 Text="07:00"
                                 Height="36"
                                 Padding="6"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Format 24 jam (contoh: 07:30 atau 21:15)"/>

                        <TextBox x:Name="CustomLabelInput"
                                 Grid.Column="1"
                                 Height="36"
                                 Margin="8,0,8,0"
                                 Padding="6"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Nama alarm (contoh: Kuliah Pagi)"/>

                        <Button x:Name="AddCustomAlarmButton"
                                Grid.Column="2"
                                Content="+ Tambah"
                                Height="36"
                                Padding="12,0"
                                Style="{StaticResource NeuButtonAccent}"
                                Click="AddCustomAlarmButton_Click"/>
                    </Grid>

                    <!-- Daftar Alarm Kustom -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CustomAlarmListPanel"/>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>