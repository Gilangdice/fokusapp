<UserControl x:Class="FokusApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10,0,0,14">
            <TextBlock x:Name="GreetText" Text="Selamat datang" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="DateText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2">
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Pomodoro" Style="{StaticResource Heading}"/>
                    <TextBlock Text="18:45" FontSize="40" FontWeight="SemiBold" Margin="0,12,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Sesi ke-2 dari 4" Style="{StaticResource Muted}"/>
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Waktu sholat berikutnya" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Dzuhur  11:52" FontSize="28" Margin="0,12,0,0"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Ashar  15:10" FontSize="18" Margin="0,8,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Catatan cepat" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Rapat tim: kirim ringkasan sebelum 14.00" TextWrapping="Wrap"
                               Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Ide fitur: notifikasi saat sesi fokus selesai" TextWrapping="Wrap"
                               Margin="0,8,0,0" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </ContentControl>
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Tugas hari ini" Style="{StaticResource Heading}"/>
                    <CheckBox Content="Revisi laporan praktikum" IsChecked="True" Margin="0,12,0,0"/>
                    <CheckBox Content="Siapkan materi presentasi" Margin="0,8,0,0"/>
                    <CheckBox Content="Olahraga sore" Margin="0,8,0,0"/>
                </StackPanel>
            </ContentControl>
        </UniformGrid>
    </Grid>
</UserControl>
