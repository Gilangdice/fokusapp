<UserControl x:Class="FokusApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Sapaan Otomatis + Jam Real-Time -->
        <Grid Margin="10,0,10,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="GreetText"
                           Text="Selamat datang"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock x:Name="DateText"
                           Style="{StaticResource Muted}"
                           FontSize="14"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="ClockText"
                           Text="00:00:00"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Waktu Lokal"
                           Style="{StaticResource Muted}"
                           FontSize="12"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Grid 4 Card -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2">

            <!-- Card 1: Pomodoro -->
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Pomodoro"
                               Style="{StaticResource Heading}"/>

                    <TextBlock x:Name="PomodoroTimeText"
                               Text="25:00"
                               FontSize="40"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock x:Name="PomodoroStatusText"
                               Text="Siap memulai • Sesi 0/4"
                               Style="{StaticResource Muted}"/>

                    <ProgressBar x:Name="PomodoroProgressBar"
                                 Value="0"
                                 Maximum="100"
                                 Height="6"
                                 Margin="0,16,0,0"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"/>
                </StackPanel>
            </ContentControl>

            <!-- Card 2: Waktu Sholat + Countdown -->
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Waktu sholat berikutnya"
                               Style="{StaticResource Heading}"/>

                    <TextBlock x:Name="NextPrayerText"
                               Text="Belum ada jadwal"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="PrayerCountdownText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock x:Name="FollowingPrayerText"
                               Text="Pilih lokasi di menu Alarm"
                               FontSize="16"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock x:Name="PrayerLocationText"
                               Text="Lokasi belum dipilih"
                               Style="{StaticResource Muted}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>

            <!-- Card 3: Catatan Cepat -->
            <ContentControl Style="{StaticResource NeuCard}">
                <StackPanel>
                    <TextBlock Text="Catatan cepat"
                               Style="{StaticResource Heading}"/>

                    <TextBlock Text="• Rapat tim: kirim ringkasan sebelum 14.00"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="• Ide fitur: notifikasi saat sesi fokus selesai"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </ContentControl>

            <!-- Card 4: Tugas Hari Ini (Interaktif + Progress Bar) -->
            <ContentControl Style="{StaticResource NeuCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Judul & Counter -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="Tugas hari ini"
                                   Style="{StaticResource Heading}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TaskProgressText"
                                   Text="0/0 selesai"
                                   Style="{StaticResource Muted}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="TaskProgressBar"
                                 Grid.Row="1"
                                 Height="6"
                                 Margin="0,8,0,10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"/>

                    <!-- Input Tambah Tugas Cepat -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewTaskInput"
                                 Grid.Column="0"
                                 Padding="8,5"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 KeyDown="NewTaskInput_KeyDown"/>

                        <Button Grid.Column="1"
                                Content="+"
                                Width="32"
                                Margin="6,0,0,0"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="AddTask_Click"/>
                    </Grid>

                    <!-- Daftar Tugas -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TaskListPanel"/>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

        </UniformGrid>
    </Grid>
</UserControl>