<UserControl x:Class="FokusApp.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <ContentControl Style="{StaticResource NeuCard}">
            <StackPanel>
                <TextBlock Text="Catatan" Style="{StaticResource Heading}"/>
                <TextBlock Text="Rapat tim" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Kirim ringkasan hasil diskusi sebelum pukul 14.00." TextWrapping="Wrap"
                           Style="{StaticResource Muted}"/>
                <TextBlock Text="Ide fitur" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Notifikasi saat sesi fokus selesai." TextWrapping="Wrap"
                           Style="{StaticResource Muted}"/>
            </StackPanel>
        </ContentControl>

        <ContentControl Grid.Column="1" Style="{StaticResource NeuCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Daftar tugas" Style="{StaticResource Heading}"/>
                <Grid DockPanel.Dock="Top" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTask" Style="{StaticResource NeuTextBox}"/>
                    <Button Grid.Column="1" Content="Tambah" Width="110" Height="44"
                            Style="{StaticResource NeuButtonAccent}" IsDefault="True" Click="Add_Click"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                                          Margin="4,8" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </ContentControl>
    </Grid>
</UserControl>
