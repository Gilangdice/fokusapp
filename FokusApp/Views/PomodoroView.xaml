<UserControl x:Class="FokusApp.Views.PomodoroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="320" Height="320">
            <Ellipse Width="300" Height="300" Stroke="{StaticResource ShBrush}"
                     StrokeThickness="14" Opacity="0.4"/>
            <Ellipse x:Name="ProgressRing" Width="300" Height="300"
                     Stroke="{StaticResource AccentBrush}" StrokeThickness="14"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ClockText" Text="25:00" FontSize="60" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Siap memulai" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <Button x:Name="StartButton" Content="Mulai" Width="150" Height="48"
                    Style="{StaticResource NeuButtonAccent}" Click="Start_Click"/>
            <Button Content="Atur ulang" Width="150" Height="48"
                    Style="{StaticResource NeuButton}" Click="Reset_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
