<Window x:Class="FokusApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fokus - Daftar" Width="460" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <ContentControl Style="{StaticResource NeuCard}" Padding="34" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Buat akun" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Isi data di bawah ini" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,2,0,18"/>

                <TextBlock Text="Username" Style="{StaticResource Muted}" Margin="6,0,0,0"/>
                <TextBox x:Name="UserBox" Style="{StaticResource NeuTextBox}"/>

                <TextBlock Text="Email" Style="{StaticResource Muted}" Margin="6,6,0,0"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource NeuTextBox}"/>

                <TextBlock Text="Password (minimal 6 karakter)" Style="{StaticResource Muted}" Margin="6,6,0,0"/>
                <PasswordBox x:Name="PassBox" Style="{StaticResource NeuPasswordBox}"/>

                <TextBlock Text="Ulangi password" Style="{StaticResource Muted}" Margin="6,6,0,0"/>
                <PasswordBox x:Name="Pass2Box" Style="{StaticResource NeuPasswordBox}"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="13"
                           Margin="6,8,0,0" MinHeight="18" TextWrapping="Wrap"/>

                <Button Content="Daftar" Height="48" Margin="0,10,0,0" IsDefault="True"
                        Style="{StaticResource NeuButtonAccent}" Click="Register_Click"/>
                <Button Content="Batal" Height="44" Margin="0,8,0,0" IsCancel="True"
                        Style="{StaticResource NeuButton}"/>
            </StackPanel>
        </ContentControl>
    </Grid>
</Window>